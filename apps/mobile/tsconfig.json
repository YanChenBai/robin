{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "WebWorker"],
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "paths": {
      "~/*": ["./src/*"],
      "vue": ["./node_modules/nativescript-vue"]
    }
  },
  "vueCompilerOptions": { "target": 3, "lib": "nativescript-vue" },
  "include": ["src", "types", "../../packages/nativescript-robin/src"]
}
